# Only the source tree is published: the decompilation (src, ledger, docs,
# tools, scripts) and the Rust port (crates). Nothing from the game disc.
/*
!/.gitignore
!/.cargo/
!/LICENSE
!/README.md
!/HANDOFF.md
!/PLAN.md
!/Cargo.toml
!/Cargo.lock
!/src/
!/crates/
!/docs/
!/ledger/
!/tools/
!/scripts/
# The Android app (its build output and the staged libnsmbw.so are ignored by android/.gitignore).
!/android/

# Build output.
target/

# Generated from the user's own disc by ppc-recomp (see crates/game-recomp).
/crates/game-recomp/gen/
# GX captures (NSMBW_GX_CAPTURE) hold game data: never commit them.
*.gxcap
